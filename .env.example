GRPC_ADDR=127.0.0.1:10021
REDIS_ADDR=127.0.0.1:6379
DATA_SOURCE=postgres://user:pass@127.0.0.1:5432/webitel?application_name=media_exporter&sslmode=disable&connect_timeout=10
CONSUL_HOST=127.0.0.1:8500
CONSUL_ID=webitel.media-exporter

MEDIA_EXPORTER_TEMP_DIR=/var/cache/webitel-media-exporter
SCREENSHOT_MAX_WIDTH=400

# Path to JSON config file (env vars take precedence over it)
CONFIG_FILE=

# Redis password (empty = no auth)
REDIS_PASSWORD=

# Redis DB number
REDIS_DB=0

# Number of concurrent export workers
WORKERS=5
